  <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.0.0-alpha.1/axios.min.js"></script>
  <script>
    // ── Main Tab Switching ──────────────────────────────────────────────
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
      });
    });

    // ── Pair / QR Toggle ───────────────────────────────────────────────
    let pairMode = 'pair';

    document.getElementById('mode-pair').addEventListener('click', () => {
      if (pairMode === 'pair') return;
      pairMode = 'pair';
      document.getElementById('mode-pair').classList.add('active');
      document.getElementById('mode-qr').classList.remove('active');
      document.getElementById('pair-num-wrap').style.display = '';
      document.getElementById('pair-btn').style.display = '';
      document.getElementById('pair-display').style.display = 'flex';
      document.getElementById('pair-display').innerHTML = '<span class="ph">Your pair code will appear here</span>';
      document.getElementById('qr-wrap').style.display = 'none';
    });

    document.getElementById('mode-qr').addEventListener('click', () => {
      if (pairMode === 'qr') return;
      pairMode = 'qr';
      document.getElementById('mode-qr').classList.add('active');
      document.getElementById('mode-pair').classList.remove('active');
      document.getElementById('pair-num-wrap').style.display = 'none';
      document.getElementById('pair-btn').style.display = 'none';
      document.getElementById('pair-display').style.display = 'none';
      document.getElementById('qr-wrap').style.display = 'none';
      fetchQR();
    });

    // ── Pair Code ──────────────────────────────────────────────────────
    document.getElementById('pair-btn').addEventListener('click', async () => {
      const num     = document.getElementById('pair-number').value.trim().replace(/[^0-9]/g, '');
      const display = document.getElementById('pair-display');
      const spinner = document.getElementById('pair-spinner');

      if (!num) {
        display.innerHTML = '<span class="err"><i class="fas fa-exclamation-circle"></i> Enter your WhatsApp number</span>';
        display.style.display = 'flex'; return;
      }

      spinner.style.display = 'block';
      display.style.display = 'none';

      try {
        const res = await axios(`/pair?number=${num}`);
        const code = res.data.code || 'Service Unavailable';
        display.innerHTML = code === 'Service Unavailable'
          ? '<span class="err"><i class="fas fa-exclamation-circle"></i> Service Unavailable</span>'
          : `<span class="ok">${code}</span>`;
      } catch {
        display.innerHTML = '<span class="err"><i class="fas fa-exclamation-circle"></i> Error — please try again</span>';
      } finally {
        spinner.style.display = 'none';
        display.style.display = 'flex';
      }
    });

    async function fetchQR() {
      const spinner = document.getElementById('pair-spinner');
      const display = document.getElementById('pair-display');
      const qrWrap  = document.getElementById('qr-wrap');
      spinner.style.display = 'block';
      try {
        const res = await axios('/qr');
        if (res.data.qr) {
          document.getElementById('qr-img').src = res.data.qr;
          document.getElementById('qr-hint').textContent =
            res.data.instructions ? res.data.instructions.join(' · ') : 'Scan with WhatsApp';
          qrWrap.style.display = 'block';
        } else {
          display.innerHTML = '<span class="err"><i class="fas fa-exclamation-circle"></i> Could not load QR</span>';
          display.style.display = 'flex';
        }
      } catch {
        display.innerHTML = '<span class="err"><i class="fas fa-exclamation-circle"></i> QR error — try again</span>';
        display.style.display = 'flex';
      } finally {
        spinner.style.display = 'none';
      }
    }

    function copyPairCode() {
      const text = document.getElementById('pair-display').innerText.trim();
      if (!text || text.includes('appear here') || text.includes('Error') || text.includes('Unavailable') || text.includes('Enter')) return;
      navigator.clipboard.writeText(text);
    }

    // ── Advanced Options ───────────────────────────────────────────────
    document.getElementById('adv-btn').addEventListener('click', () => {
      const sec  = document.getElementById('adv-sec');
      const chev = document.getElementById('adv-chev');
      sec.classList.toggle('open');
      chev.style.transform = sec.classList.contains('open') ? 'rotate(180deg)' : '';
    });

    // ── Generate Script (WITH FULL COLOR LOGGER) ───────────────────────
    let generatedCode = '';

    function generateScript() {
      const name       = document.getElementById('d-name').value.trim()    || 'USER';
      const number     = document.getElementById('d-number').value.trim()  || '';
      const session    = document.getElementById('d-session').value.trim() || '';
      const botname    = document.getElementById('d-botname').value.trim() || 'CODY AI';
      const prefix     = document.getElementById('d-prefix').value.trim()  || '.';
      const mode       = document.getElementById('d-mode').value;
      const autoread   = document.getElementById('d-autoread').checked   ? 'true' : 'false';
      const autostatus = document.getElementById('d-autostatus').checked ? 'true' : 'false';

      if (!number || !session || session.includes('paste_your')) {
        const btn = document.getElementById('gen-btn');
        btn.style.background = 'var(--danger)';
        btn.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Fill in required fields first';
        setTimeout(() => {
          btn.style.background = '';
          btn.innerHTML = '<i class="fas fa-wand-magic-sparkles"></i> Generate index.js';
        }, 2500);
        return;
      }

      generatedCode = buildScript({ name, number, session, botname, prefix, mode, autoread, autostatus });

      const body = document.getElementById('script-body');
      body.innerHTML = `<pre>${escHtml(generatedCode)}</pre>`;
      document.getElementById('dl-btn').style.display = '';
      document.getElementById('run-hint').style.display = 'flex';

      document.getElementById('script-body').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function escHtml(s) {
      return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    function buildScript({ name, number, session, botname, prefix, mode, autoread, autostatus }) {
      return `/**
 * ╔══════════════════════════════════════╗
 * ║   C⚉DY AI  ◦  Starter v2            ║
 * ║   Generated by CODY AI Deploy Builder║
 * ╚══════════════════════════════════════╝
 *
 * Fully configured — just run:  npm start
 */

import { execSync, spawn } from 'child_process';
import fs   from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));

// ─── Colors for beautiful logging ────────────────────────────────────────
const colors = {
    reset:     '\\x1b[0m',
    bright:    '\\x1b[1m',
    dim:       '\\x1b[2m',
    black:     '\\x1b[30m',
    red:       '\\x1b[31m',
    green:     '\\x1b[32m',
    yellow:    '\\x1b[33m',
    blue:      '\\x1b[34m',
    magenta:   '\\x1b[35m',
    cyan:      '\\x1b[36m',
    white:     '\\x1b[37m',
    bgRed:     '\\x1b[41m',
    bgGreen:   '\\x1b[42m',
    bgYellow:  '\\x1b[43m',
    bgBlue:    '\\x1b[44m',
    bgMagenta: '\\x1b[45m',
    bgCyan:    '\\x1b[46m',
    bold:      '\\x1b[1m',
    underline: '\\x1b[4m',
    blink:     '\\x1b[5m',
    reverse:   '\\x1b[7m'
};

// ─── Fancy logger with colors ────────────────────────────────────────────
const log = {
    header: (msg) => console.log(\`\\n\${colors.bgCyan}\${colors.black}\${colors.bold} ⚡ \${msg} \${colors.reset}\`),
    success: (msg) => console.log(\`  \${colors.green}\${colors.bold}✓\${colors.reset}  \${colors.green}\${msg}\${colors.reset}\`),
    error: (msg) => console.log(\`  \${colors.red}\${colors.bold}✗\${colors.reset}  \${colors.red}\${msg}\${colors.reset}\`),
    warning: (msg) => console.log(\`  \${colors.yellow}\${colors.bold}⚠\${colors.reset}  \${colors.yellow}\${msg}\${colors.reset}\`),
    info: (msg) => console.log(\`  \${colors.cyan}\${colors.bold}◦\${colors.reset}  \${colors.cyan}\${msg}\${colors.reset}\`),
    star: (msg) => console.log(\`  \${colors.magenta}\${colors.bold}✦\${colors.reset}  \${colors.magenta}\${msg}\${colors.reset}\`),
    bot: (msg) => console.log(\`  \${colors.blue}\${colors.bold}🤖\${colors.reset}  \${colors.blue}\${msg}\${colors.reset}\`),
    line: () => console.log(\`  \${colors.dim}\${'─'.repeat(50)}\${colors.reset}\`),
    title: (msg) => {
        const line = '═'.repeat(msg.length + 4);
        console.log(\`\\n\${colors.yellow}\${colors.bold}╔\${line}╗\${colors.reset}\`);
        console.log(\`\${colors.yellow}\${colors.bold}║  \${msg}  ║\${colors.reset}\`);
        console.log(\`\${colors.yellow}\${colors.bold}╚\${line}╝\${colors.reset}\\n\`);
    },
    loading: (msg) => {
        const frames = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏'];
        let i = 0;
        const interval = setInterval(() => {
            process.stdout.write(\`\\r  \${colors.cyan}\${frames[i]}\${colors.reset}  \${colors.cyan}\${msg}\${colors.reset}\`);
            i = (i + 1) % frames.length;
        }, 80);
        return interval;
    },
    stopLoading: (interval, success = true) => {
        clearInterval(interval);
        process.stdout.write('\\r');
        if (success) {
            console.log(\`  \${colors.green}✓\${colors.reset}  \${colors.green}Done!\${colors.reset}\`);
        } else {
            console.log(\`  \${colors.red}✗\${colors.reset}  \${colors.red}Failed!\${colors.reset}\`);
        }
    }
};

