// ─── Helper: Validate base64 ─────────────────────────────────────────────
function isValidBase64(str) {
    try {
        return btoa(atob(str)) === str;
    } catch {
        return false;
    }
}

// ─── Helper: Check if already configured ─────────────────────────────────
function isAlreadyConfigured() {
    const envPath = path.join(BOT_DIR, '.env');
    const credsPath = path.join(BOT_DIR, 'sessions', 'creds.json');
    
    if (fs.existsSync(envPath) && fs.existsSync(credsPath)) {
        const envContent = fs.readFileSync(envPath, 'utf8');
        if (envContent.includes(\`SESSION_ID=\${SESSION_ID}\`) && 
            envContent.includes(\`OWNER_NUMBER=\${OWNER_NUMBER}\`)) {
            return true;
        }
    }
    return false;
}

// ─── Session resolver (FULLY FIXED WITH KV SUPPORT) ──────────────────────
async function resolveSession(sid) {
    if (!sid) return null;

    // ── CLOUDFLARE KV SHORT ID ──
    if (sid.includes('!KV:')) {
        const shortId = sid.split('!KV:').pop();
        log.info(\`Fetching session from Cloudflare KV (ID: \${shortId})...\`);
        
        const loadingInterval = log.loading('Downloading from KV...');
        
        try {
            const res = await fetch(\`https://id.crysnova.qzz.io/session/load/\${shortId}\`);
            const data = await res.json();
            
            clearInterval(loadingInterval);
            process.stdout.write('\\r');
            
            if (data.sessionData) {
                log.success('Session loaded from Cloudflare KV');
                return data.sessionData;
            } else if (data.data) {
                log.success('Session loaded from Cloudflare KV');
                return typeof data.data === 'string' ? data.data : JSON.stringify(data.data);
            } else {
                log.warning('KV session not found: ' + (data.error || 'unknown'));
                return null;
            }
        } catch (err) {
            clearInterval(loadingInterval);
            process.stdout.write('\\r');
            log.error('KV fetch failed: ' + err.message);
            return null;
        }
    }

    // ── MEGA SESSION ──
    if (sid.startsWith('CODY_AI!M:')) {
        log.info('Resolving Mega session...');
        const megaUrl = sid.slice('CODY_AI!M:'.length);
        const mega    = await import('megajs');
        const file    = mega.File.fromURL(megaUrl);

        return new Promise((resolve, reject) => {
            file.loadAttributes(err => {
                if (err) return reject(new Error('Mega load failed: ' + err));
                file.downloadBuffer((err, buf) => {
                    if (err) return reject(new Error('Mega download: ' + err));
                    log.success('Session downloaded from Mega');
                    resolve(buf.toString('utf8'));
                });
            });
        });
    }

    // ── BASE64 SESSION (with validation) ──
    log.info('Decoding base64 session...');
    let b64 = sid;
    
    if (sid.includes('!')) {
        b64 = sid.split('!').pop();
    }
    
    if (isValidBase64(b64)) {
        const decoded = Buffer.from(b64, 'base64').toString('utf8');
        if (decoded && decoded.trim().length > 0) {
            log.success('Base64 session decoded successfully');
            return decoded;
        }
    }
    
    log.warning('Invalid or unsupported session format');
    return null;
}

